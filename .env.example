# Firebase Configuration for La Radiolina
# Copia este archivo a .env o .env.local y completa con los valores reales de tu proyecto de Firebase.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=radiolina-musica.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=radiolina-musica
VITE_FIREBASE_STORAGE_BUCKET=radiolina-musica.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=100000000000
VITE_FIREBASE_APP_ID=1:100000000000:web:abcdef123456

# (Opcional) REST Endpoint fallback alternativo en lugar de Firebase:
# VITE_CLOUD_STORAGE_URL=https://api.jsonbin.io/v3/b/...
